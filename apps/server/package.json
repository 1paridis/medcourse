    "start": "node dist/index.js"
  },
  "dependencies": {
    "@medcourse/shared": "*",
    "@fastify/static": "^10.1.5",
    "dotenv": "^18.0.6",
    "fastify": "^5.12.5",
    "playwright": "^1.64.0"
  },
  "devDependencies": {
    "tsx": "^4.23.15"
  }
}
